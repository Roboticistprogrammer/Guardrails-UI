# Copy to .env (gitignored). scripts/dev.sh loads it.

# mock (default, offline, no keys) | hosted (build.nvidia.com) | local (NIM container)
GUARDRAILS_MODE=mock

# Needed for hosted and local: the main model is always NVIDIA-hosted.
# NVIDIA_API_KEY=nvapi-...

# Local mode only: the topic-control NIM started with the docker run in README.md.
# TOPIC_CONTROL_URL=http://localhost:8123/v1
